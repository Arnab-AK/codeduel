# Copy this to .env for local dev. Values here match docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://codeduel:codeduel_dev_only@localhost:5432/codeduel
REDIS_URL=redis://localhost:6379/0

# Sandbox execution limits — centralized here so they're one env change away
# from tuning, not buried in code. See execution/limits.py for how they're used.
SANDBOX_MEMORY_LIMIT=256m
SANDBOX_CPU_LIMIT=0.5
SANDBOX_PIDS_LIMIT=64
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MAX_CONCURRENT=4
